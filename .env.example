# Copy to .env.local for local development, and add the same keys to your
# hosting provider's environment variables for production.

# Public URL of the site (canonical links, social previews, QR codes on passes).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Bookings (required in production) --------------------------------------
# Signs booking links and QR codes so passes can't be forged. 32+ random
# characters; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates every existing pass link and QR code.
BOOKING_SIGNING_SECRET=

# Code staff use to sign in at /staff (8+ characters). Share only with the team.
STAFF_ACCESS_CODE=

# Supabase project (Settings > API). The service-role key is secret: server only,
# never in NEXT_PUBLIC_ variables. Run supabase/migrations/0001_bookings.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional ------------------------------------------------------------------
# Rate limits shared across all server instances (https://upstash.com, free tier).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email alerts to staff for every new booking and event request (https://resend.com).
RESEND_API_KEY=
BOOKING_ADMIN_EMAIL=elgrecoresturant@gmail.com
BOOKING_FROM_EMAIL="El Greco Bookings <bookings@your-domain.com>"

# Local testing of `next start` without Supabase (stores bookings in .data/). Never in production.
# ALLOW_FILE_BOOKING_STORE=1
